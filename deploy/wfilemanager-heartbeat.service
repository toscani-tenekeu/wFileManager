[Unit]
Description=wFileManager legacy Pro retirement heartbeat
After=network-online.target wfilemanager.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/wfilemanager/heartbeat.sh
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=false
ProtectHome=false
