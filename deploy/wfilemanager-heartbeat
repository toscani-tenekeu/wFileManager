#!/usr/bin/env bash
set -Eeuo pipefail

ENV_FILE="${WFILEMANAGER_ENV_FILE:-/etc/wfilemanager/wfilemanager.env}"
INSTANCE_SECRET_FILE="${WFILEMANAGER_INSTANCE_SECRET_FILE:-/etc/wfilemanager/instance-secret.key}"
RECOVERY_KEY_FILE="${WFILEMANAGER_RECOVERY_KEY_FILE:-/etc/wfilemanager/root-reset.key}"

[[ -f "$ENV_FILE" ]] || exit 0
set -a
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a

[[ "${WFILEMANAGER_DATABASE_MODE:-}" == "supabase" ]] || exit 0

INSTANCE_KEY="${WFILEMANAGER_INSTANCE_KEY:-}"
SUPABASE_URL="${WFILEMANAGER_SUPABASE_URL:-${VITE_SUPABASE_URL:-}}"
LIFECYCLE_URL="${WFILEMANAGER_LIFECYCLE_API_URL:-${SUPABASE_URL%/}/functions/v1/wfilemanager-instance-lifecycle-api}"
HOSTNAME_VALUE="$(hostname -f 2>/dev/null || hostname)"
BASE_URL="${WFILEMANAGER_PUBLIC_BASE_URL:-}"
APP_VERSION="$(node -p "require('/opt/wfilemanager/current/package.json').version" 2>/dev/null || true)"
CAPABILITY="pro-decommission-v1"

[[ -n "$INSTANCE_KEY" && "$LIFECYCLE_URL" == https://* ]] || {
  echo "wFileManager heartbeat deferred: lifecycle configuration is incomplete." >&2
  exit 0
}

AUTH_HEADER=()
if [[ -s "$INSTANCE_SECRET_FILE" ]]; then
  INSTANCE_SECRET="$(tr -d '\r\n' <"$INSTANCE_SECRET_FILE")"
  AUTH_HEADER=(-H "x-wfilemanager-instance-secret: $INSTANCE_SECRET")
elif [[ -s "$RECOVERY_KEY_FILE" ]]; then
  RECOVERY_KEY="$(tr -d '\r\n' <"$RECOVERY_KEY_FILE")"
  AUTH_HEADER=(-H "x-wfilemanager-recovery-key: $RECOVERY_KEY")
  echo "wFileManager heartbeat is using the legacy recovery-key fallback; regenerate the Pro instance secret during the next recovery or reinstall." >&2
else
  echo "wFileManager heartbeat skipped: no instance secret or Recovery Kit key is available." >&2
  exit 0
fi

BODY="$(jq -cn \
  --arg hostname "$HOSTNAME_VALUE" \
  --arg baseUrl "$BASE_URL" \
  --arg appVersion "$APP_VERSION" \
  --arg capability "$CAPABILITY" \
  '{hostname:$hostname,baseUrl:$baseUrl,appVersion:$appVersion,capabilities:[$capability]}')"
RESPONSE_FILE="$(mktemp)"
trap 'rm -f "$RESPONSE_FILE"' EXIT

HTTP_STATUS="$(curl -sS --connect-timeout 10 --max-time 45 \
  -o "$RESPONSE_FILE" -w '%{http_code}' \
  -X POST "${LIFECYCLE_URL%/}/heartbeat" \
  -H 'Content-Type: application/json' \
  -H "x-wfilemanager-instance: $INSTANCE_KEY" \
  "${AUTH_HEADER[@]}" \
  --data "$BODY" || true)"

if [[ "$HTTP_STATUS" != "200" ]]; then
  MESSAGE="$(jq -r '.error // empty' "$RESPONSE_FILE" 2>/dev/null || true)"
  case "$HTTP_STATUS" in
    401|402|403|404|410|423)
      echo "wFileManager heartbeat skipped (HTTP ${HTTP_STATUS}${MESSAGE:+: $MESSAGE})." >&2
      echo "This usually means the Pro instance is not activated, billing is suspended, the remote account was deleted, or the local Recovery Kit does not match the remote account." >&2
      exit 0
      ;;
    *)
      echo "wFileManager heartbeat deferred (HTTP ${HTTP_STATUS:-unknown}${MESSAGE:+: $MESSAGE}). It will retry automatically." >&2
      exit 0
      ;;
  esac
fi

if jq -e '.success == true and .action == "retire-pro"' "$RESPONSE_FILE" >/dev/null; then
  ACTION_AUTHORIZATION="$(jq -r '.actionAuthorization // empty' "$RESPONSE_FILE")"
  if [[ ! "$ACTION_AUTHORIZATION" =~ ^[a-f0-9]{64}$ ]]; then
    echo "wFileManager Pro retirement deferred: invalid action authorization." >&2
    exit 0
  fi
  echo "Authenticated wFileManager Pro retirement request received."
  /usr/local/sbin/wfilemanager-uninstall \
    --retire-pro \
    --app-version "$APP_VERSION" \
    --authorization "$ACTION_AUTHORIZATION"
  exit $?
fi

if jq -e '.success == true and .status == "active"' "$RESPONSE_FILE" >/dev/null; then
  exit 0
fi

if jq -e '.paymentRequired == true' "$RESPONSE_FILE" >/dev/null; then
  echo "wFileManager heartbeat skipped: Pro payment is required for this instance." >&2
  exit 0
fi

echo "wFileManager heartbeat deferred: the lifecycle service returned an unexpected response. It will retry automatically." >&2
cat "$RESPONSE_FILE" >&2
exit 0
